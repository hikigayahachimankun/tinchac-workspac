# Template from the project plan. Fixture runs use an empty Gemini key.
APP_MODE=fixture
DATABASE_PATH=./data/private/tinchac.sqlite3
PRIVATE_DIR=./data/private
CORPUS_DIR=./data/corpus
APP_TIMEZONE=Asia/Ho_Chi_Minh
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_INPUT_PRICE_PER_MILLION_USD=0.30
LLM_OUTPUT_PRICE_PER_MILLION_USD=2.50
USD_VND_PLANNING_RATE=27000
LLM_BUDGET_USD=3.00
MAX_CONCURRENT_JOBS=2
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=12000000
MAX_INPUT_CHARS=6000
RESOURCE_TTL_HOURS=24
OCR_LANGUAGES=vie+eng
OCR_TIMEOUT_SECONDS=20
ALLOW_PUBLIC_ACCESS=false
# HTTP live remains disabled until model/pricing/quota preflight and budget approval.
LLM_LIVE_ENABLED=false
